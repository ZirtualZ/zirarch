#!/bin/sh
set -u

export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/0}
export GDK_GL=0
export GSK_RENDERER=cairo
export GDK_DPI_SCALE=1
export GTK_THEME=Adwaita:light
export QT_SCALE_FACTOR=1
export QT_FONT_DPI=168
export QT_STYLE_OVERRIDE=Fusion
mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"
dbus-uuidgen --ensure 2>/dev/null || :

STATE=/run/fieldm-supervisor-state
LOG=/var/log/fieldm-session.log
mkdir -p /run /var/log
touch "$LOG"

rotate_log()
{
	size=$(wc -c < "$LOG" 2>/dev/null || echo 0)
	case "$size" in ''|*[!0-9]*) size=0 ;; esac
	if [ "$size" -gt 1048576 ]; then
		mv -f "$LOG" "$LOG.1" 2>/dev/null || :
		touch "$LOG"
	fi
}

log()
{
	rotate_log
	printf '[%s] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)" "$*" >> "$LOG"
}

write_state()
{
	printf '%s\n' "$1" > "$STATE"
}

enter_recovery()
{
	write_state recovery
	log "bounded supervisor entered recovery; starting framebuffer console"
	rc-service zirarch-x11-refresh stop >/dev/null 2>&1 || :
	pkill -TERM -x Xorg 2>/dev/null || :
	sleep 1
	pkill -KILL -x Xorg 2>/dev/null || :
	printf '\033[2J\033[H' > /dev/tty1 2>/dev/null || :
	chvt 1 2>/dev/null || :
	printf '0\n' > /sys/class/graphics/fb0/blank 2>/dev/null || :
	if [ -x /usr/bin/zirarch-fbconsole ]; then
		exec /usr/bin/zirarch-fbconsole
	fi
	exit 1
}

if [ ! -x /usr/bin/simple-desktop ] &&
   [ ! -x /usr/local/bin/simple-desktop ]; then
	log "simple-desktop is not installed"
	enter_recovery
fi

touch_device=
for event in /sys/class/input/event*; do
	[ "$(cat "$event/device/name" 2>/dev/null)" = sec_touchscreen ] || continue
	touch_device="/dev/input/$(basename "$event")"
	break
done
[ -n "$touch_device" ] ||
	{
		log "sec_touchscreen input device is unavailable"
		enter_recovery
	}
sed -i "s#Option \"Device\" \"/dev/input/event[0-9][0-9]*\"#Option \"Device\" \"$touch_device\"#" \
	/etc/X11/xorg.conf.d/20-on5-touchscreen.conf

cat > /root/.xinitrc <<'EOF'
#!/bin/sh
export XDG_SESSION_TYPE=x11
export XDG_CURRENT_DESKTOP=FieldM
xrdb -merge <<'XRESOURCES'
Xft.dpi: 168
Xft.antialias: 1
Xft.hinting: 1
Xft.rgba: rgb
XTerm*background: #F4F1EA
XTerm*foreground: #111111
XTerm*cursorColor: #111111
XTerm*faceName: DejaVu Sans Mono
XTerm*faceSize: 11
XTerm*scrollBar: false
XTerm*saveLines: 2000
XRESOURCES
rc-service zirarch-x11-refresh start
xrandr --output default --mode 720x1280 2>/dev/null || true
matchbox-window-manager -use_titlebar no -use_cursor no &
/usr/bin/fieldm-keyboard warm
exec dbus-run-session -- /usr/bin/fieldm-desktop-launch
EOF
chmod 700 /root/.xinitrc

write_state starting-x
started=$(date +%s 2>/dev/null || echo 0)
log "starting X session"
exec startx /root/.xinitrc -- :0 vt1 -nolisten tcp
