#!/bin/sh
set -u

export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/0}
export GDK_GL=0
export GSK_RENDERER=cairo
export GDK_DPI_SCALE=1
theme=light
background='#F4F1EA'
foreground='#111111'
if grep -qx 'theme=dark' /root/.config/simple-desktop/features 2>/dev/null; then
	theme=dark
	background='#161513'
	foreground='#EAE6DD'
fi

if [ ! -s /etc/timezone ]; then
	printf 'America/Chicago\n' >/etc/timezone
	unlink /etc/localtime 2>/dev/null || :
	ln -s /usr/share/zoneinfo/America/Chicago /etc/localtime
fi
export GTK_THEME="Adwaita:$theme"
export QT_SCALE_FACTOR=1
export QT_FONT_DPI=168
export QT_STYLE_OVERRIDE=Fusion
export GTK_MODULES=gail:atk-bridge
export MOZ_USE_ATSPI=1
unset NO_AT_BRIDGE
mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"
dbus-uuidgen --ensure 2>/dev/null || :

if [ ! -x /usr/bin/simple-desktop ] &&
   [ ! -x /usr/local/bin/simple-desktop ]; then
	echo "fieldm-session: simple-desktop is not installed" >&2
	exit 1
fi

touch_device=
for event in /sys/class/input/event*; do
	[ "$(cat "$event/device/name" 2>/dev/null)" = sec_touchscreen ] || continue
	touch_device="/dev/input/$(basename "$event")"
	break
done
[ -n "$touch_device" ] ||
	{
		echo "fieldm-session: sec_touchscreen input device is unavailable" >&2
		exit 1
	}
sed -i "s#Option \"Device\" \"/dev/input/event[0-9][0-9]*\"#Option \"Device\" \"$touch_device\"#" \
	/etc/X11/xorg.conf.d/20-on5-touchscreen.conf

cat > /root/.xinitrc <<EOF
#!/bin/sh
export XDG_SESSION_TYPE=x11
export XDG_CURRENT_DESKTOP=FieldM
export GTK_MODULES=gail:atk-bridge
export MOZ_USE_ATSPI=1
unset NO_AT_BRIDGE
xrdb -merge <<'XRESOURCES'
Xft.dpi: 168
Xft.antialias: 1
Xft.hinting: 1
Xft.rgba: rgb
XTerm*background: $background
XTerm*foreground: $foreground
XTerm*cursorColor: $foreground
XTerm*faceName: DejaVu Sans Mono
XTerm*faceSize: 11
XTerm*scrollBar: false
XTerm*saveLines: 2000
XRESOURCES
matchbox-window-manager -use_titlebar no -use_cursor no &
exec dbus-run-session -- sh -c '
	/usr/libexec/at-spi-bus-launcher --launch-immediately >/tmp/at-spi-bus.log 2>&1 &
	/usr/libexec/at-spi2-registryd >/tmp/at-spi-registry.log 2>&1 &
	exec /usr/bin/fieldm-desktop-launch
'
EOF
chmod 700 /root/.xinitrc

exec startx /root/.xinitrc -- :0 vt1 -nolisten tcp
