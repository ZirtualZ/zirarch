#!/usr/bin/python3

import datetime
import glob
import os
import sys

ALARM_DIR = "/data/root/.config/fieldm/alarms"
WAKEALARM = "/sys/class/rtc/rtc0/wakealarm"

def read_alarm(path):
    data = {}
    try:
        for line in open(path):
            key, sep, value = line.strip().partition("=")
            if sep:
                data[key] = value
    except OSError:
        pass
    return data

def next_alarm():
    now = datetime.datetime.now()
    candidates = []
    for path in glob.glob(ALARM_DIR + "/*.alarm"):
        alarm = read_alarm(path)
        if alarm.get("enabled") != "1":
            continue
        try:
            hour, minute = map(int, alarm["time"].split(":"))
        except (KeyError, ValueError):
            continue
        candidate = now.replace(hour=hour, minute=minute, second=0,
                                microsecond=0)
        if candidate <= now:
            candidate += datetime.timedelta(days=1)
        candidates.append((candidate, alarm, path))
    return min(candidates, default=(None, None, None))

def set_wakealarm():
    candidate, alarm, path = next_alarm()
    if candidate is None:
        return
    epoch = int(candidate.timestamp())
    try:
        open(WAKEALARM, "w").write("0")
        open(WAKEALARM, "w").write(str(max(1, epoch - int(datetime.datetime.now().timestamp()))))
    except OSError:
        pass
    print(candidate.strftime("%Y-%m-%d %H:%M"))

def add_alarm(time, label=""):
    os.makedirs(ALARM_DIR, exist_ok=True)
    safe = "".join(ch for ch in time if ch.isdigit() or ch == ":")
    path = os.path.join(ALARM_DIR, safe.replace(":", "-") + ".alarm")
    with open(path, "w") as f:
        f.write("enabled=1\n")
        f.write("time=%s\n" % safe)
        f.write("label=%s\n" % label)

def list_alarms():
    for path in sorted(glob.glob(ALARM_DIR + "/*.alarm")):
        alarm = read_alarm(path)
        print("%s\t%s\t%s" % (alarm.get("time", "?"),
                               alarm.get("enabled", "0"),
                               alarm.get("label", "")))

if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("usage: zirarch-alarm list|add HH:MM [label]|next")
        sys.exit(1)
    command = sys.argv[1]
    if command == "list":
        list_alarms()
    elif command == "add" and len(sys.argv) >= 3:
        add_alarm(sys.argv[2], " ".join(sys.argv[3:]))
        set_wakealarm()
    elif command == "next":
        set_wakealarm()
