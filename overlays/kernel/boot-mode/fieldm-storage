#!/bin/sh
set -u

SD_DEV=
for dev in /dev/mmcblk1p1 /dev/mmcblk1; do
	[ -b "$dev" ] && SD_DEV=$dev
done

status_storage()
{
	printf 'SYSTEM\t'
	df -h / 2>/dev/null | awk 'NR==2 {printf "%s\t%s\t%s\n",$2,$3,$4}'
	printf 'DATA\t'
	if [ -d /data ]; then
		df -h /data 2>/dev/null | awk 'NR==2 {printf "%s\t%s\t%s\n",$2,$3,$4}'
	else
		printf 'unavailable\t-\t-\n'
	fi
	if [ -n "$SD_DEV" ]; then
		size=$(blockdev --getsize64 "$SD_DEV" 2>/dev/null)
		label=$(blkid -o value -s LABEL "$SD_DEV" 2>/dev/null)
		printf 'SD\t%s\t%s\t%s\n' "${size:-unknown}" "${label:-none}" "$SD_DEV"
	else
		printf 'SD\tabsent\t-\t-\n'
	fi
}

format_sd()
{
	[ "${1:-}" = --confirm ] || {
		echo "format-sd requires --confirm" >&2
		exit 2
	}
	[ -n "$SD_DEV" ] || { echo "microSD unavailable" >&2; exit 1; }
	mountpoint -q /mnt/zirarch-sd && umount /mnt/zirarch-sd
	umount "$SD_DEV" 2>/dev/null || true
	mkfs.ext4 -F -L zirarch-sd \
		-O ^64bit,^metadata_csum,^metadata_csum_seed "$SD_DEV"
}

use_sd()
{
	[ -n "$SD_DEV" ] || { echo "microSD unavailable" >&2; exit 1; }
	mkdir -p /mnt/zirarch-sd
	mount -t ext4 -o noatime LABEL=zirarch-sd /mnt/zirarch-sd ||
		exit 1
	mkdir -p /mnt/zirarch-sd/root-data
	# Copy existing app/file state once. Never bind unless the destination
	# has the SSH guard so a missing SD cannot hide the system root.
	[ -f /root/.ssh/authorized_keys ] ||
		[ -f /mnt/zirarch-sd/root-data/.ssh/authorized_keys ] ||
		{ echo "refusing SD root bind: SSH guard missing" >&2; exit 1; }
	tar -C /root -cf - . |
		tar -C /mnt/zirarch-sd/root-data -xf -
	mkdir -p /root/.config/fieldm
	printf 'microsd\n' >/root/.config/fieldm/storage-location
	grep -v '^LABEL=zirarch-sd' /etc/fstab >/tmp/fstab.fieldm 2>/dev/null || :
	printf 'LABEL=zirarch-sd /mnt/zirarch-sd ext4 defaults,nofail,noatime 0 2\n' \
		>>/tmp/fstab.fieldm
	mv /tmp/fstab.fieldm /etc/fstab
}

case "${1:-status}" in
	status) status_storage ;;
	format-sd) shift; format_sd "$@" ;;
	use-sd) use_sd ;;
	*) echo "usage: fieldm-storage status|format-sd --confirm|use-sd" >&2; exit 1 ;;
esac
