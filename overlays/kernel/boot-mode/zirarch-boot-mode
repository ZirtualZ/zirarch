#!/bin/sh
set -u

mode=${ZIRARCH_BOOT_MODE:-}
if [ -z "$mode" ] && [ -r /run/zirarch-boot-mode ]; then
	mode=$(cat /run/zirarch-boot-mode)
fi
if [ -z "$mode" ]; then
	/usr/bin/zirarch-fbconsole --boot-menu
	case $? in
		2) mode=gui ;;
		*) mode=tty ;;
	esac
fi

printf '%s\n' "$mode" > /run/zirarch-boot-mode
case "$mode" in
	gui)
		while :; do
			/usr/bin/fieldm-session
			echo "FieldM session ended; restarting in 2 seconds" \
				>/tmp/zirarch-fieldm-restart.log
			sleep 2
		done
		;;
	tty)
		if rc-service buffyboard start 2>/dev/null; then
			printf '\033[2J\033[H' > /dev/tty1
			chvt 2
			chvt 1
			getty=/sbin/getty
			[ -x "$getty" ] || getty=/sbin/agetty
			start-stop-daemon --start --background --make-pidfile \
				--pidfile /run/zirarch-tty1.pid \
				--exec "$getty" -- 38400 tty1 linux
			while :; do
				sleep 3600
			done
		else
			exec /usr/bin/zirarch-fbconsole
		fi
		;;
	*)
		echo "zirarch-boot-mode: invalid mode: $mode" >&2
		exit 1
		;;
esac
