#!/bin/sh
set -u

BOOT_UPTIME=$(cut -d. -f1 /proc/uptime 2>/dev/null || echo 0)
mkdir -p /var/log
: >>/var/log/zirarch-boot-timing.log
printf 'boot_mode_start=%s\n' "$BOOT_UPTIME" \
	>>/var/log/zirarch-boot-timing.log

mode=gui
volume_down_held()
{
	for event in /dev/input/event*; do
		name=
		for sysfs in /sys/class/input/"${event##*/}"/device/name \
			/sys/class/input/"${event##*/}"/device/name; do
			[ -r "$sysfs" ] && name=$(cat "$sysfs" 2>/dev/null)
		done
		case "$name" in
			*gpio*key*|*gpio-keys*|*sec_powerkey*|*Power*Key*)
				[ -r "$event" ] || continue
				timeout 1 python3 - "$event" <<'PY'
import fcntl, select, struct, sys
try:
    fd = open(sys.argv[1], "rb", buffering=0)
except OSError:
    raise SystemExit(1)
ready, _, _ = select.select([fd], [], [], 1.0)
if not ready:
    raise SystemExit(1)
while ready:
    data = fd.read(16)
    if len(data) != 16:
        break
    sec, usec, kind, code, value = struct.unpack("llHHi", data)
    if kind == 1 and code == 114 and value in (1, 2):
        raise SystemExit(0)
    ready, _, _ = select.select([fd], [], [], 0.05)
raise SystemExit(1)
PY
				[ $? -eq 0 ] && return 0
				;;
		esac
	done
	return 1
}

if volume_down_held; then
	mode=tty
fi

printf '%s\n' "$mode" > /run/zirarch-boot-mode
log=/var/log/zirarch-boot-mode.log
mkdir -p /var/log
touch "$log"
log_message()
{
	size=$(wc -c < "$log" 2>/dev/null || echo 0)
	case "$size" in ''|*[!0-9]*) size=0 ;; esac
	if [ "$size" -gt 1048576 ]; then
		mv -f "$log" "$log.1" 2>/dev/null || :
		touch "$log"
	fi
	printf '[%s] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)" "$*" >> "$log"
}
case "$mode" in
	gui)
		start-stop-daemon --stop --name zirarch-fbconsole 2>/dev/null || true
		[ ! -x /usr/bin/zirarch-post ] ||
			/usr/bin/zirarch-post --boot
		start-stop-daemon --stop --name zirarch-fbconsole 2>/dev/null || true
		sleep 1
		printf 'fieldm_start=%s\n' "$(cut -d. -f1 /proc/uptime 2>/dev/null || echo 0)" \
			>>/var/log/zirarch-boot-timing.log
		exec /usr/bin/fieldm-session
		;;
	tty)
		if rc-service buffyboard start 2>/dev/null; then
			printf '\033[2J\033[H' > /dev/tty1
			chvt 2
			chvt 1
			getty=/sbin/getty
			[ -x "$getty" ] || getty=/sbin/agetty
			start-stop-daemon --start --background --make-pidfile \
				--pidfile /run/zirarch-tty1.pid \
				--exec "$getty" -- 38400 tty1 linux
			while :; do
				sleep 3600
			done
		else
			exec /usr/bin/zirarch-fbconsole
		fi
		;;
	*)
		echo "zirarch-boot-mode: invalid mode: $mode" >&2
		exit 1
		;;
esac
