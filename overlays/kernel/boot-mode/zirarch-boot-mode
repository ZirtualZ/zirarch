#!/bin/sh
set -u

mode=${ZIRARCH_BOOT_MODE:-}
if [ -z "$mode" ] && [ -r /run/zirarch-boot-mode ]; then
	mode=$(cat /run/zirarch-boot-mode)
fi
if [ -z "$mode" ]; then
	/usr/bin/zirarch-fbconsole --boot-menu
	case $? in
		2) mode=gui ;;
		*) mode=tty ;;
	esac
fi

printf '%s\n' "$mode" > /run/zirarch-boot-mode
log=/var/log/zirarch-boot-mode.log
mkdir -p /var/log
touch "$log"
log_message()
{
	size=$(wc -c < "$log" 2>/dev/null || echo 0)
	case "$size" in ''|*[!0-9]*) size=0 ;; esac
	if [ "$size" -gt 1048576 ]; then
		mv -f "$log" "$log.1" 2>/dev/null || :
		touch "$log"
	fi
	printf '[%s] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)" "$*" >> "$log"
}
case "$mode" in
	gui)
		failures=0
		window_start=$(date +%s 2>/dev/null || echo 0)
		while :; do
			now=$(date +%s 2>/dev/null || echo 0)
			if [ $((now - window_start)) -ge 300 ]; then
				failures=0
				window_start=$now
			fi
			if [ "$failures" -ge 5 ]; then
				printf 'recovery\n' > /run/zirarch-boot-mode
				printf 'recovery\n' > /run/fieldm-supervisor-state
				log_message "GUI supervisor failed 5 times; entering framebuffer recovery"
				chvt 1 2>/dev/null || :
				exec /usr/bin/zirarch-fbconsole
			fi
			started=$(date +%s 2>/dev/null || echo 0)
			/usr/bin/fieldm-session
			status=$?
			ended=$(date +%s 2>/dev/null || echo 0)
			log_message "fieldm-session exit_status=$status elapsed=$((ended-started))s failures=$((failures+1))"
			failures=$((failures + 1))
			delay=$((failures * 2))
			[ "$delay" -le 30 ] || delay=30
			sleep "$delay"
		done
		;;
	tty)
		if rc-service buffyboard start 2>/dev/null; then
			printf '\033[2J\033[H' > /dev/tty1
			chvt 2
			chvt 1
			getty=/sbin/getty
			[ -x "$getty" ] || getty=/sbin/agetty
			start-stop-daemon --start --background --make-pidfile \
				--pidfile /run/zirarch-tty1.pid \
				--exec "$getty" -- 38400 tty1 linux
			while :; do
				sleep 3600
			done
		else
			exec /usr/bin/zirarch-fbconsole
		fi
		;;
	*)
		echo "zirarch-boot-mode: invalid mode: $mode" >&2
		exit 1
		;;
esac
