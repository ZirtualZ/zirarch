#!/bin/sh
set -u

BOOT_UPTIME=$(cut -d. -f1 /proc/uptime 2>/dev/null || echo 0)
mkdir -p /var/log
: >>/var/log/zirarch-boot-timing.log
printf 'boot_mode_start=%s\n' "$BOOT_UPTIME" \
	>>/var/log/zirarch-boot-timing.log

mode=gui
volume_down_held()
{
	[ -x /usr/bin/zirarch-volume-down ] &&
		/usr/bin/zirarch-volume-down
	return $?
}

if volume_down_held; then
	mode=tty
fi

printf '%s\n' "$mode" > /run/zirarch-boot-mode
log=/var/log/zirarch-boot-mode.log
mkdir -p /var/log
touch "$log"
log_message()
{
	size=$(wc -c < "$log" 2>/dev/null || echo 0)
	case "$size" in ''|*[!0-9]*) size=0 ;; esac
	if [ "$size" -gt 1048576 ]; then
		mv -f "$log" "$log.1" 2>/dev/null || :
		touch "$log"
	fi
	printf '[%s] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)" "$*" >> "$log"
}
case "$mode" in
	gui)
		start-stop-daemon --stop --name zirarch-fbconsole 2>/dev/null || true
		[ ! -x /usr/bin/zirarch-post ] ||
			/usr/bin/zirarch-post --boot
		start-stop-daemon --stop --name zirarch-fbconsole 2>/dev/null || true
		printf 'fieldm_start=%s\n' "$(cut -d. -f1 /proc/uptime 2>/dev/null || echo 0)" \
			>>/var/log/zirarch-boot-timing.log
		exec /usr/bin/fieldm-session
		;;
	tty)
		printf '\033[2J\033[H' >/dev/tty1
		getty=/sbin/getty
		[ -x "$getty" ] || getty=/sbin/agetty
		exec "$getty" 38400 tty1 linux
		;;
	*)
		echo "zirarch-boot-mode: invalid mode: $mode" >&2
		exit 1
		;;
esac
