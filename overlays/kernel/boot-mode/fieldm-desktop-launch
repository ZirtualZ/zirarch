#!/bin/sh
set -u

PIDFILE=/run/fieldm-desktop.pid
STATE=/run/fieldm-supervisor-state
LOG=/var/log/fieldm-desktop.log
echo $$ > "$PIDFILE"
printf 'running\n' > "$STATE"
mkdir -p /run/fieldm-keyboard
touch "$LOG"

log()
{
	size=$(wc -c < "$LOG" 2>/dev/null || echo 0)
	case "$size" in ''|*[!0-9]*) size=0 ;; esac
	if [ "$size" -gt 1048576 ]; then
		mv -f "$LOG" "$LOG.1" 2>/dev/null || : >/dev/null
	fi
	printf '[%s] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)" "$*" >> "$LOG"
}

rm -f /run/fieldm-keyboard/manual \
	/run/fieldm-keyboard/entry \
	/run/fieldm-keyboard/terminal
rm -f /run/fieldm-keyboard/hide-sequence
/usr/bin/fieldm-keyboard warm

failures=0
window_start=$(date +%s 2>/dev/null || echo 0)
while :; do
	now=$(date +%s 2>/dev/null || echo 0)
	if [ "$failures" -ge 5 ] && [ $((now - window_start)) -lt 300 ]; then
		printf 'recovery\n' > "$STATE"
		log "desktop supervisor entered recovery after $failures failures"
		exit 1
	fi
	if [ $((now - window_start)) -ge 300 ]; then
		failures=0
		window_start=$now
	fi

	started=$(date +%s 2>/dev/null || echo 0)
	simple-desktop --x-session >>"$LOG" 2>&1 &
	desktop_pid=$!
	echo "$desktop_pid" > "$PIDFILE"
	log "started simple-desktop pid=$desktop_pid"
	wait "$desktop_pid"
	status=$?
	ended=$(date +%s 2>/dev/null || echo 0)
	log "simple-desktop pid=$desktop_pid exit_status=$status elapsed=$((ended-started))s"
	failures=$((failures + 1))
	printf 'desktop-restart\n' > "$STATE"
	sleep 2
done
