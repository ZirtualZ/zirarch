#!/bin/sh
set -u

PIDFILE=/run/fieldm-desktop.pid
STATE=/run/fieldm-supervisor-state
LOG=/var/log/fieldm-desktop.log
echo $$ > "$PIDFILE"
printf 'running\n' > "$STATE"
mkdir -p /run/fieldm-keyboard
touch "$LOG"

log()
{
	size=$(wc -c < "$LOG" 2>/dev/null || echo 0)
	case "$size" in ''|*[!0-9]*) size=0 ;; esac
	if [ "$size" -gt 1048576 ]; then
		mv -f "$LOG" "$LOG.1" 2>/dev/null || : >/dev/null
	fi
	printf '[%s] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)" "$*" >> "$LOG"
}

rm -f /run/fieldm-keyboard/manual \
	/run/fieldm-keyboard/entry \
	/run/fieldm-keyboard/terminal
rm -f /run/fieldm-keyboard/hide-sequence
(
	sleep 1
	(
		sleep 1
		/usr/bin/fieldm-keyboard warm >/dev/null 2>&1 || true
		/usr/bin/fieldm-imd >/tmp/fieldm-imd.log 2>&1 &
	) & >/dev/null 2>&1 || true
	/usr/bin/fieldm-imd >/tmp/fieldm-imd.log 2>&1 &
) &

uptime=$(cut -d. -f1 /proc/uptime 2>/dev/null || printf unknown)
printf '%s\n' "$uptime" > /run/zirarch-gui-started
if [ -r /var/log/zirarch-post.log ]; then
	tmp=/var/log/zirarch-post.log.gui
	{
		grep -v '^gui	' /var/log/zirarch-post.log 2>/dev/null || true
		printf 'gui\tPASS\tGUI\tFieldM started at %ss after boot\n' "$uptime"
	} > "$tmp"
	mv "$tmp" /var/log/zirarch-post.log
fi

exec simple-desktop --x-session
