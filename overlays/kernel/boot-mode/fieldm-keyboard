#!/bin/sh
set -u

state_dir=/run/fieldm-keyboard
pidfile="$state_dir/pid"
logfile=/var/log/fieldm-keyboard.log
lockfile="$state_dir/lock"
mkdir -p "$state_dir"
touch "$logfile"
exec >>"$logfile" 2>&1
exec 9>"$lockfile"
flock 9 2>/dev/null || :
DISPLAY=${DISPLAY:-:0}
export DISPLAY

size=$(wc -c < "$logfile" 2>/dev/null || echo 0)
case "$size" in ''|*[!0-9]*) size=0 ;; esac
if [ "$size" -gt 1048576 ]; then
	mv -f "$logfile" "$logfile.1" 2>/dev/null || : >/dev/null
	touch "$logfile"
fi

keyboard_pid()
{
	[ -s "$pidfile" ] || return 1
	read -r pid < "$pidfile" || return 1
	case "$pid" in ''|*[!0-9]*) return 1 ;; esac
	kill -0 "$pid" 2>/dev/null || return 1
	tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null |
		grep -Eq '(^|[ /])(fieldm-kbd|svkbd)([[:space:]]|$)'
}

keyboard_visible()
{
	[ -e "$state_dir/manual" ] ||
		[ -e "$state_dir/entry" ] ||
		[ -e "$state_dir/terminal" ]
}

auto_show_enabled()
{
	[ "$(sed -n 's/^auto_show=//p' "${HOME:-/root}/.config/fieldm/keyboard.conf" \
		2>/dev/null | tail -n 1)" != off ]
}

sync_terminal_state()
{
	keyboard_pid || return 0
	read -r pid < "$pidfile"
	kill -HUP "$pid" 2>/dev/null || :
	if [ -e "$state_dir/terminal" ]; then
		kill -USR1 "$pid" 2>/dev/null || :
	else
		kill -USR2 "$pid" 2>/dev/null || :
	fi
}

start_keyboard()
{
	rm -f "$pidfile"
	exec 9>&-
	if command -v fieldm-kbd >/dev/null 2>&1; then
		fieldm-kbd &
	elif command -v svkbd-mobile-intl >/dev/null 2>&1; then
		svkbd-mobile-intl -d -g 720x320+0+960 &
	elif command -v svkbd >/dev/null 2>&1; then
		svkbd -d -g 720x320+0+960 &
	else
		echo "fieldm-keyboard: no keyboard installed" >&2
		return 1
	fi
	echo "$!" > "$pidfile"
	printf 'keyboard-running\n' > "$state_dir/state"
}

stop_keyboard()
{
	if keyboard_pid; then
		read -r pid < "$pidfile"
		kill "$pid" 2>/dev/null || :
	fi
	rm -f "$pidfile"
	for proc in /proc/[0-9]*; do
		pid=${proc#/proc/}
		[ "$pid" = "$$" ] && continue
		cmd=$(tr '\0' ' ' < "$proc/cmdline" 2>/dev/null) || continue
		case "$cmd" in
			*"fieldm-kbd"*|*"svkbd-mobile-intl"*|*"svkbd"*)
				kill "$pid" 2>/dev/null || :
				;;
		esac
	done
}

reconcile()
{
	if keyboard_visible; then
		if keyboard_pid; then
			sync_terminal_state
		else
			start_keyboard
		fi
	else
		stop_keyboard
	fi
}

if [ "${1:-}" = warm ]; then
	keyboard_pid && exit 0
	start_keyboard || exit 0
	exit 0
fi

lease=${1:-manual}
action=${2:-toggle}
case "$lease" in manual|entry|terminal) ;; *) exit 1 ;; esac
case "$action" in
	on)
		if [ "$lease" = manual ] || auto_show_enabled; then
			touch "$state_dir/$lease"
		fi
		;;
	off) rm -f "$state_dir/$lease" ;;
	toggle)
		if [ "$lease" != manual ] && ! auto_show_enabled; then
			rm -f "$state_dir/$lease"
			reconcile
			exit 0
		fi
		[ -e "$state_dir/$lease" ] &&
			rm -f "$state_dir/$lease" ||
			touch "$state_dir/$lease"
		;;
	*) exit 1 ;;
esac
reconcile
